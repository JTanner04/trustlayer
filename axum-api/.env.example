# Copy these placeholder values into local environment variables. Do not commit a real .env file.
DATABASE_URL=postgres://<postgres-user>:<postgres-password>@localhost:5432/trustlayer
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
PORT=3001

# Optional: enables Solana Devnet review-verification records.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_KEYPAIR_PATH=/absolute/path/outside/this/repository/to/devnet-keypair.json
